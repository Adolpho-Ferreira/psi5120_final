{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PermissaoLogsCloudWatch",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:<ACCOUNT_ID>:log-group:/aws/lambda/FlorestaHumidityCalibrator:*"
    },
    {
      "Sid": "PersistenciaLeiturasDynamoDB",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:GetItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:<ACCOUNT_ID>:table/LeiturasSensoresCalibrados"
    }
  ]
}
